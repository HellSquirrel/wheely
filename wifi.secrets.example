# Copy to wifi.secrets (gitignored) and fill in. Read by build.rs at compile time.
# Quotes around values are optional (KEY=value and KEY='value' both work).
WIFI_SSID=MyNetwork
WIFI_PASSWORD=hunter2
# Laptop listens on this UDP port (tools/telemetry.py). Optional, default 4210.
TELEMETRY_PORT=4210
# Send to one laptop instead of broadcasting (needed on Wi-Fi with client isolation). Optional.
#TELEMETRY_HOST=192.168.1.50
